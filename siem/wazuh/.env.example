# Wazuh single-node stack — copy to .env and change every value before starting.
#
# The values below are the defaults published in Wazuh's own single-node
# example. They are here so the stack starts, not because they are safe. The
# indexer password in particular must match what the certificate generation
# step and the dashboard both expect, so change it once, here, before the
# first run rather than after.

INDEXER_PASSWORD=SecretPassword
WAZUH_API_PASSWORD=MyS3cr37P450r.*-
DASHBOARD_PASSWORD=kibanaserver
