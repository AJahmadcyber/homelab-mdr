alert tcp $HOME_NET any -> $HOME_NET any (msg:"LOCAL SCAN Internal horizontal SYN scan T1046"; flow:to_server; flags:S; threshold:type both, track by_src, count 20, seconds 10; classtype:attempted-recon; sid:1000001; rev:1;)
alert tcp $EXTERNAL_NET any -> $HOME_NET any (msg:"LOCAL SCAN External-to-internal SYN scan T1046"; flow:to_server; flags:S; threshold:type both, track by_src, count 20, seconds 10; classtype:attempted-recon; sid:1000002; rev:1;)
alert dns any any -> any any (msg:"LOCAL DNS Long subdomain - possible DNS tunneling/exfil T1048"; dns.query; pcre:"/[a-z0-9]{50,}/i"; classtype:bad-unknown; sid:1000003; rev:1;)
alert http any any -> $HOME_NET any (msg:"LOCAL EXPLOIT Fortinet CVE-2024-55591 Auth Bypass Pattern - local_access_token"; flow:established,to_server; http.uri; content:"local_access_token"; nocase; classtype:attempted-admin; reference:cve,2024-55591; sid:100350; rev:2; metadata:mitre_technique_id T1190;)
